--- !u!114 &8225773106519220806
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3115082010432739800}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=\"center\"><size=40><b><color=#FBEF00>TH\xCD NGHI\u1EC6M: T\xC1CH
    N\u01AF\u1EDAC V\xC0 C\u1ED2N \n(PH\u01AF\u01A0NG PH\xC1P CH\u01AFNG C\u1EA4T)</color></b></size></align>\n\n<size=32><b><color=#FBEF00>1.
    M\u1EE5c ti\xEAu</color></b></size>\n<size=26>\u2022 Hi\u1EC3u nguy\xEAn t\u1EAFc
    t\xE1ch dung d\u1ECBch d\u1EF1a v\xE0o s\u1EF1 kh\xE1c nhau v\u1EC1 nhi\u1EC7t
    \u0111\u1ED9 s\xF4i.\n\u2022 Bi\u1EBFt thao t\xE1c ch\u01B0ng c\u1EA5t ph\xE2n
    \u0111o\u1EA1n \u0111\u1EC3 t\xE1ch ri\xEAng c\u1ED3n t\u1EEB h\u1ED7n h\u1EE3p
    n\u01B0\u1EDBc \u2013 c\u1ED3n.</size>\n\n<size=32><b><color=#FBEF00>2. D\u1EE5ng
    c\u1EE5 \u2013 H\xF3a ch\u1EA5t</color></b></size>\n<size=26>\u2022 B\xECnh c\u1EA5t
    (b\xECnh c\u1EA7u)\n\u2022 \u1ED0ng sinh h\xE0n\n\u2022 Nhi\u1EC7t k\u1EBF\n\u2022
    B\u1EBFp \u0111un / \u0110\xE8n c\u1ED3n\n\u2022 B\xECnh ng\u01B0ng\n\u2022 H\u1ED7n
    h\u1EE3p n\u01B0\u1EDBc v\xE0 c\u1ED3n (ethanol)</size>\n\n<size=32><b><color=#FBEF00>3.
    C\xE1ch ti\u1EBFn h\xE0nh</color></b></size>\n<size=26>\u2022 R\xF3t h\u1ED7n
    h\u1EE3p n\u01B0\u1EDBc \u2013 c\u1ED3n v\xE0o b\xECnh c\u1EA5t.\n\u2022 L\u1EAFp
    b\u1ED9 d\u1EE5ng c\u1EE5 ch\u01B0ng c\u1EA5t \u0111\xFAng quy tr\xECnh, c\xF3
    g\u1EAFn nhi\u1EC7t k\u1EBF tr\xEAn c\u1ED5 b\xECnh.\n\u2022 \u0110un n\xF3ng
    h\u1ED7n h\u1EE3p t\u1EEB t\u1EEB.\n\u2022 Quan s\xE1t nhi\u1EC7t \u0111\u1ED9:
    h\u01A1i b\u1EAFt \u0111\u1EA7u bay l\xEAn kho\u1EA3ng 78\xB0C (nhi\u1EC7t \u0111\u1ED9
    s\xF4i c\u1EE7a c\u1ED3n).\n\u2022 H\u01A1i c\u1ED3n \u0111i qua \u1ED1ng sinh
    h\xE0n v\xE0 ng\u01B0ng t\u1EE5 th\xE0nh ch\u1EA5t l\u1ECFng ch\u1EA3y xu\u1ED1ng
    b\xECnh ng\u01B0ng.\n\u2022 Khi nhi\u1EC7t \u0111\u1ED9 t\u0103ng g\u1EA7n 100\xB0C,
    d\u1EEBng thu c\u1ED3n \u0111\u1EC3 tr\xE1nh n\u01B0\u1EDBc ng\u01B0ng t\u1EE5
    theo.</size>\n\n<size=32><b><color=#FBEF00>4. Hi\u1EC7n t\u01B0\u1EE3ng \u2013
    K\u1EBFt lu\u1EADn</color></b></size>\n<size=26>\u2022 Khi nhi\u1EC7t \u0111\u1ED9
    \u0111\u1EA1t kho\u1EA3ng 78\xB0C, h\u01A1i c\u1ED3n tho\xE1t ra v\xE0 ng\u01B0ng
    t\u1EE5 th\xE0nh ch\u1EA5t l\u1ECFng.\n\u2022 C\u1ED3n thu \u0111\u01B0\u1EE3c
    \u1EDF b\xECnh ng\u01B0ng, l\u01B0\u1EE3ng n\u01B0\u1EDBc c\xF2n l\u1EA1i trong
    b\xECnh c\u1EA5t t\u0103ng l\xEAn.\n\u2022 Ph\u01B0\u01A1ng ph\xE1p ch\u01B0ng
    c\u1EA5t t\xE1ch ri\xEAng c\u1ED3n v\xE0 n\u01B0\u1EDBc d\u1EF1a v\xE0o s\u1EF1
    kh\xE1c nhau v\u1EC1 nhi\u1EC7t \u0111\u1ED9 s\xF4i \n(c\u1ED3n s\xF4i th\u1EA5p
    h\u01A1n n\u01B0\u1EDBc).</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7362f3990db07954a9570669bf1a5bdd, type: 2}
