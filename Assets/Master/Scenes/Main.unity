--- !u!114 &7427901233783221073
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4469852635701317839}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=center><color=#FFD700><b>TH\xCD NGHI\u1EC6M\r\nQUAN S\xC1T QU\xC1
    TR\xCCNH CHUY\u1EC2N TH\u1EC2\r\nTH\xD4NG QUA H\xCCNH D\u1EA0NG C\u1EE6A NGUY\xCAN
    T\u1EEC V\xC0 \r\nC\xC1C Y\u1EBEU T\u1ED0 \u1EA2NH H\u01AF\u1EDENG</b></color></align>\n\n\r\n<color=#FBEF00><b>1.
    Kh\xE1i ni\u1EC7m</b></color>  \n\r\nV\u1EADt ch\u1EA5t t\u1ED3n t\u1EA1i ch\u1EE7
    y\u1EBFu \u1EDF ba tr\u1EA1ng th\xE1i c\u01A1 b\u1EA3n l\xE0 <b>r\u1EAFn, l\u1ECFng
    v\xE0 kh\xED</b>.  \nTr\u1EA1ng th\xE1i c\u1EE7a v\u1EADt ch\u1EA5t ph\u1EE5
    thu\u1ED9c v\xE0o <b>c\xE1ch s\u1EAFp x\u1EBFp</b> v\xE0 <b>m\u1EE9c \u0111\u1ED9
    chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a c\xE1c nguy\xEAn t\u1EED</b>, ch\u1ECBu \u1EA3nh
    h\u01B0\u1EDFng tr\u1EF1c ti\u1EBFp b\u1EDFi <b>nhi\u1EC7t \u0111\u1ED9</b> v\xE0
    <b>\xE1p su\u1EA5t</b>.\r\n\r\r\n<color=#FBEF00><b>2. \u0110\u1EB7c \u0111i\u1EC3m
    c\xE1c tr\u1EA1ng th\xE1i v\u1EADt ch\u1EA5t</b></color>  \r\n\r\n<b>\u2022 Tr\u1EA1ng
    th\xE1i r\u1EAFn:</b>  \r\nC\xE1c nguy\xEAn t\u1EED s\u1EAFp x\u1EBFp ch\u1EB7t
    ch\u1EBD, dao \u0111\u1ED9ng nh\u1EB9 quanh v\u1ECB tr\xED c\xE2n b\u1EB1ng. 
    \r\nCh\u1EA5t r\u1EAFn c\xF3 h\xECnh d\u1EA1ng v\xE0 th\u1EC3 t\xEDch x\xE1c
    \u0111\u1ECBnh.\r\n\r<b>\u2022 Tr\u1EA1ng th\xE1i l\u1ECFng:</b>  \r\nC\xE1c
    nguy\xEAn t\u1EED \u1EDF g\u1EA7n nhau nh\u01B0ng c\xF3 th\u1EC3 tr\u01B0\u1EE3t
    qua nhau.  \r\nCh\u1EA5t l\u1ECFng c\xF3 th\u1EC3 t\xEDch x\xE1c \u0111\u1ECBnh,
    h\xECnh d\u1EA1ng ph\u1EE5 thu\u1ED9c v\xE0o b\xECnh ch\u1EE9a.\r\n\r<b>\u2022
    Tr\u1EA1ng th\xE1i kh\xED:</b>  \r\nC\xE1c nguy\xEAn t\u1EED \u1EDF xa nhau,
    chuy\u1EC3n \u0111\u1ED9ng nhanh v\xE0 h\u1ED7n lo\u1EA1n.  \r\nCh\u1EA5t kh\xED
    kh\xF4ng c\xF3 h\xECnh d\u1EA1ng v\xE0 th\u1EC3 t\xEDch x\xE1c \u0111\u1ECBnh,
    d\u1EC5 n\xE9n v\xE0 gi\xE3n n\u1EDF.\r\n\r\n<color=#FBEF00><b>3. \u1EA2nh h\u01B0\u1EDFng
    c\u1EE7a nhi\u1EC7t \u0111\u1ED9</b></color>  \n\r\nNhi\u1EC7t \u0111\u1ED9 th\u1EC3
    hi\u1EC7n m\u1EE9c \u0111\u1ED9 chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a c\xE1c nguy\xEAn
    t\u1EED.  \r\n\u2022 Khi nhi\u1EC7t \u0111\u1ED9 th\u1EA5p, c\xE1c nguy\xEAn
    t\u1EED chuy\u1EC3n \u0111\u1ED9ng ch\u1EADm, ch\u1EA5t th\u01B0\u1EDDng \u1EDF
    tr\u1EA1ng th\xE1i <b>r\u1EAFn</b>.  \r\n\u2022 Khi nhi\u1EC7t \u0111\u1ED9 t\u0103ng
    l\xEAn m\u1EE9c trung b\xECnh, c\xE1c nguy\xEAn t\u1EED chuy\u1EC3n \u0111\u1ED9ng
    m\u1EA1nh h\u01A1n, ch\u1EA5t chuy\u1EC3n sang tr\u1EA1ng th\xE1i <b>l\u1ECFng</b>. 
    \r\n\u2022 Khi nhi\u1EC7t \u0111\u1ED9 cao, c\xE1c nguy\xEAn t\u1EED chuy\u1EC3n
    \u0111\u1ED9ng r\u1EA5t nhanh, ch\u1EA5t d\u1EC5 chuy\u1EC3n sang tr\u1EA1ng
    th\xE1i <b>kh\xED</b>.\r\n\r\n<color=#FBEF00><b>4. \u1EA2nh h\u01B0\u1EDFng c\u1EE7a
    \xE1p su\u1EA5t</b></color>  \n\r\n\xC1p su\u1EA5t l\xE0 l\u1EF1c t\xE1c d\u1EE5ng
    l\xEAn th\xE0nh b\xECnh do c\xE1c nguy\xEAn t\u1EED va ch\u1EA1m t\u1EA1o ra. 
    \r\n\u2022 \xC1p su\u1EA5t cao l\xE0m c\xE1c nguy\xEAn t\u1EED \u1EDF g\u1EA7n
    nhau h\u01A1n, gi\xFAp duy tr\xEC tr\u1EA1ng th\xE1i r\u1EAFn ho\u1EB7c l\u1ECFng. 
    \r\n\u2022 \xC1p su\u1EA5t th\u1EA5p l\xE0m c\xE1c nguy\xEAn t\u1EED d\u1EC5
    t\xE1ch xa nhau, tr\u1EA1ng th\xE1i kh\xED d\u1EC5 h\xECnh th\xE0nh h\u01A1n.\r\n\r\n<color=#FBEF00><b>5.
    K\u1EBFt lu\u1EADn</b></color>  \n\r\nTh\xF4ng qua th\xED nghi\u1EC7m, c\xF3
    th\u1EC3 quan s\xE1t tr\u1EF1c quan s\u1EF1 chuy\u1EC3n \u0111\u1ED5i gi\u1EEFa
    c\xE1c tr\u1EA1ng th\xE1i r\u1EAFn, l\u1ECFng v\xE0 kh\xED d\u1EF1a tr\xEAn h\xECnh
    d\u1EA1ng v\xE0 chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a c\xE1c nguy\xEAn t\u1EED
    khi thay \u0111\u1ED5i nhi\u1EC7t \u0111\u1ED9 v\xE0 \xE1p su\u1EA5t."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7362f3990db07954a9570669bf1a5bdd, type: 2}
  m_sharedMaterial: {fileID: 2164040, guid: 7362f3990db07954a9570669bf1a5bdd, type: 2}
